	third_party/lpeg/lpegpreload.c \
	third_party/lpeg/lpprint.c \
	third_party/lpeg/lptree.c \
	third_party/lpeg/lpvm.c \
	third_party/lpeg/notice.c

THIRD_PARTY_LPEG_A_OBJS = $(THIRD_PARTY_LPEG_A_SRCS:%.c=o/$(MODE)/%.o)

