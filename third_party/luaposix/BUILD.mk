# generated by scripts/luaext.py -- edit that, not this

PKGS += THIRD_PARTY_LUAPOSIX

THIRD_PARTY_LUAPOSIX_ARTIFACTS += THIRD_PARTY_LUAPOSIX_A
THIRD_PARTY_LUAPOSIX = $(THIRD_PARTY_LUAPOSIX_A_DEPS) $(THIRD_PARTY_LUAPOSIX_A)
THIRD_PARTY_LUAPOSIX_A = o/$(MODE)/third_party/luaposix/luaposix.a

THIRD_PARTY_LUAPOSIX_A_HDRS =\
	third_party/luaposix/compat-5.2.h \
	third_party/luaposix/cosmo.h \
	third_party/luaposix/lposixpreload.h

THIRD_PARTY_LUAPOSIX_A_SRCS =\
	third_party/luaposix/lposixpreload.c \
	third_party/luaposix/notice.c \
	third_party/luaposix/posix.c

THIRD_PARTY_LUAPOSIX_A_INCS =\
	third_party/luaposix/_helpers.c \
	third_party/luaposix/compat-5.2.c \
	third_party/luaposix/ctype.c \
	third_party/luaposix/dirent.c \
	third_party/luaposix/errno.c \
	third_party/luaposix/fcntl.c \
	third_party/luaposix/fnmatch.c \
	third_party/luaposix/glob.c \
	third_party/luaposix/grp.c \
	third_party/luaposix/libgen.c \
	third_party/luaposix/poll.c \
	third_party/luaposix/pwd.c \
	third_party/luaposix/sched.c \
	third_party/luaposix/signal.c \
	third_party/luaposix/stdio.c \
	third_party/luaposix/stdlib.c \
	third_party/luaposix/sys/msg.c \
	third_party/luaposix/sys/resource.c \
	third_party/luaposix/sys/socket.c \
	third_party/luaposix/sys/stat.c \
	third_party/luaposix/sys/statvfs.c \
	third_party/luaposix/sys/time.c \
	third_party/luaposix/sys/times.c \
	third_party/luaposix/sys/utsname.c \
	third_party/luaposix/sys/wait.c \
	third_party/luaposix/syslog.c \
	third_party/luaposix/termio.c \
	third_party/luaposix/time.c \
	third_party/luaposix/unistd.c \
	third_party/luaposix/utime.c

THIRD_PARTY_LUAPOSIX_A_OBJS = $(THIRD_PARTY_LUAPOSIX_A_SRCS:%.c=o/$(MODE)/%.o)

THIRD_PARTY_LUAPOSIX_A_OK_HDRS =\
	third_party/luaposix/cosmo.h \
	third_party/luaposix/lposixpreload.h

THIRD_PARTY_LUAPOSIX_A_CHECKS =\
	$(THIRD_PARTY_LUAPOSIX_A).pkg \
	$(THIRD_PARTY_LUAPOSIX_A_OK_HDRS:%=o/$(MODE)/%.ok)

THIRD_PARTY_LUAPOSIX_A_DIRECTDEPS =\
	LIBC_CALLS \
	LIBC_FMT \
	LIBC_INTRIN \
	LIBC_LOG \
	LIBC_MEM \
	LIBC_NEXGEN32E \
	LIBC_PROC \
	LIBC_RUNTIME \
	LIBC_SOCK \
	LIBC_STDIO \
	LIBC_STR \
	LIBC_SYSV \
	LIBC_SYSV_CALLS \
	LIBC_THREAD \
	LIBC_X \
	THIRD_PARTY_GETOPT \
	THIRD_PARTY_MUSL \
	THIRD_PARTY_TZ

THIRD_PARTY_LUAPOSIX_A_DEPS :=\
	$(call uniq,$(foreach x,$(THIRD_PARTY_LUAPOSIX_A_DIRECTDEPS),$($(x))))

$(THIRD_PARTY_LUAPOSIX_A):\
	third_party/luaposix/ \
	$(THIRD_PARTY_LUAPOSIX_A).pkg \
	$(THIRD_PARTY_LUAPOSIX_A_OBJS)

$(THIRD_PARTY_LUAPOSIX_A).pkg:\
	$(THIRD_PARTY_LUAPOSIX_A_OBJS) \
	o/$(MODE)/third_party/lua/lua.a.pkg \
	$(foreach x,$(THIRD_PARTY_LUAPOSIX_A_DIRECTDEPS),$($(x)_A).pkg)

# upstream reads its HAVE_* feature macros before including anything of
# its own, so the cosmo configuration has to come in ahead of the source.
$(THIRD_PARTY_LUAPOSIX_A_OBJS): private CPPFLAGS +=\
	-include third_party/luaposix/cosmo.h

$(THIRD_PARTY_LUAPOSIX_A_OBJS): private CFLAGS +=\
	-ffunction-sections \
	-fdata-sections \
	-Wno-unused-variable \
	-Wno-address

# the pure-Lua half of luaposix, stored in the binary's zip directory as
# .lua/posix/*.lua, which is where cosmo's LUA_PATH looks first.  -C2
# strips the leading third_party/luaposix/ from each zip entry name.
THIRD_PARTY_LUAPOSIX_LUAS = $(wildcard third_party/luaposix/.lua/posix/*.lua)
THIRD_PARTY_LUAPOSIX_ZIPOBJS =\
	$(THIRD_PARTY_LUAPOSIX_LUAS:%=o/$(MODE)/%.zip.o)

$(THIRD_PARTY_LUAPOSIX_ZIPOBJS): private ZIPOBJ_FLAGS +=\
	-C2

THIRD_PARTY_LUAPOSIX_LIBS = $(foreach x,$(THIRD_PARTY_LUAPOSIX_ARTIFACTS),$($(x)))
THIRD_PARTY_LUAPOSIX_SRCS = $(foreach x,$(THIRD_PARTY_LUAPOSIX_ARTIFACTS),$($(x)_SRCS))
THIRD_PARTY_LUAPOSIX_HDRS = $(foreach x,$(THIRD_PARTY_LUAPOSIX_ARTIFACTS),$($(x)_HDRS))
THIRD_PARTY_LUAPOSIX_INCS = $(foreach x,$(THIRD_PARTY_LUAPOSIX_ARTIFACTS),$($(x)_INCS))
THIRD_PARTY_LUAPOSIX_OBJS = $(foreach x,$(THIRD_PARTY_LUAPOSIX_ARTIFACTS),$($(x)_OBJS))
THIRD_PARTY_LUAPOSIX_CHECKS = $(foreach x,$(THIRD_PARTY_LUAPOSIX_ARTIFACTS),$($(x)_CHECKS))
$(THIRD_PARTY_LUAPOSIX_OBJS): third_party/luaposix/BUILD.mk

.PHONY: o/$(MODE)/third_party/luaposix
o/$(MODE)/third_party/luaposix: $(THIRD_PARTY_LUAPOSIX_CHECKS)
