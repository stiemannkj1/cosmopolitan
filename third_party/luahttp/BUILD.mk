THIRD_PARTY_LUAHTTP_LUAS =\
	$(wildcard third_party/luahttp/.lua/*.lua) \
	$(wildcard third_party/luahttp/.lua/http/*.lua) \
	$(wildcard third_party/luahttp/.lua/http/compat/*.lua) \
	$(wildcard third_party/luahttp/.lua/lpeg_patterns/*.lua)

THIRD_PARTY_LUAHTTP_ZIPOBJS =\
	$(THIRD_PARTY_LUAHTTP_LUAS:%=o/$(MODE)/%.zip.o)

# -C2 strips the leading third_party/luahttp/ from each zip entry name
$(THIRD_PARTY_LUAHTTP_ZIPOBJS): private ZIPOBJ_FLAGS +=\
	-C2

.PHONY: o/$(MODE)/third_party/luahttp
o/$(MODE)/third_party/luahttp: $(THIRD_PARTY_LUAHTTP_ZIPOBJS)
